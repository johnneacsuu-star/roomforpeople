---
// Întrebări scurte cu răspunsuri scurte, fără JavaScript: <details>.
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((i) => <details><summary>{i.q}</summary><p class="small">{i.a}</p></details>)}
</div>
<style>
  .faq { display: flex; flex-direction: column; border-top: 1px solid var(--ink); }
  .faq details { border-bottom: 1px solid var(--ink); }
  .faq summary { cursor: pointer; padding: 16px 0; font-family: var(--display); font-weight: 700; font-size: 17px; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .faq summary::after { content: "+"; font-weight: 400; }
  .faq details[open] summary::after { content: "–"; }
  .faq p { padding: 0 0 18px; max-width: 64ch; }
</style>
