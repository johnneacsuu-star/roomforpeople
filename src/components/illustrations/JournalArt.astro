---
// Imaginea fiecărui articol: un desen în stilul casei, nu o fotografie generată. Cinci motive, alese din frontmatter prin `art`.
import HandFilter from './HandFilter.astro';
import People from './People.astro';
interface Props { art: 'phone' | 'door' | 'search' | 'evening' | 'voice'; id?: string; class?: string; title?: string }
const { art, id = 'ja', class: cls = '', title = '' } = Astro.props;
const titles = {
  phone: 'Un om cu telefonul în mână, seara, și un mesaj trimis la 22:40',
  door: 'Doi oameni în cameră; AI-ul rămâne dincolo de ușă',
  search: 'O căutare cu patru răspunsuri și un loc gol pentru al cincilea',
  evening: 'O zi: timpul cu oamenii neatins, a doua tură seara',
  voice: 'O voce înregistrată trei minute devine un text',
};
---
<svg class={`jart ${cls}`} viewBox="0 0 680 340" role="img" aria-label={title || titles[art]}>
  <HandFilter id={`${id}-hand`} />
  <rect x="0" y="0" width="680" height="340" fill="var(--paper)" />
  <g filter={`url(#${id}-hand)`} class="hand-ink draw">
    {art === 'phone' && <>
      <People kind="phone" x={200} y={120} scale={1.1} />
      <path d="M300 96 H540 V176 H300 Z" />
      <path d="M300 136 L284 146 L300 152" />
      <path d="M320 118 H520 M320 138 H500 M320 158 H440" stroke-width="1.4" />
      <path d="M100 258 H560" stroke-dasharray="3 6" />
      <path d="M440 200 H548 V236 H440 Z M452 212 H536 M452 226 H520" stroke-width="1.2" stroke-dasharray="2 3" />
    </>}
    {art === 'door' && <>
      <People kind="listener" x={150} y={120} scale={0.95} />
      <People kind="speaker" x={270} y={120} scale={0.95} />
      <path class="talk" d="M170 114 C 190 96, 230 96, 250 114" stroke-dasharray="2 5" />
      <path d="M100 228 H320" />
      <g transform="translate(372,106)"><rect x="0" y="0" width="56" height="70" rx="3" stroke-width="2.6" /><path class="leafp" d="M8 3 L27 10 L27 60 L8 67 Z" /></g>
      <path d="M470 108 H600 V172 H470 Z" stroke-dasharray="4 4" />
      <path d="M486 124 H584 M486 140 H570 M486 156 H560" stroke-width="1.2" stroke-dasharray="4 4" />
      <path d="M440 140 H462" stroke-width="2.2" />
      <path d="M452 128 L462 140 L452 152" stroke-width="2.2" />
      <path d="M452 152 L470 140 L452 128" stroke="var(--alert)" stroke-width="2.2" transform="translate(0 0)" />
    </>}
    {art === 'search' && <>
      <path d="M120 70 H560 V110 H120 Z" />
      <circle cx="146" cy="90" r="8" /><path d="M152 96 L160 104" />
      <path d="M180 90 H420" stroke-width="1.4" />
      <path d="M120 140 H420 M120 174 H400 M120 208 H430 M120 242 H410" stroke-width="1.6" />
      <circle cx="104" cy="140" r="4" fill="currentColor" /><circle cx="104" cy="174" r="4" fill="currentColor" /><circle cx="104" cy="208" r="4" fill="currentColor" /><circle cx="104" cy="242" r="4" fill="currentColor" />
      <path d="M96 276 H440" stroke-dasharray="3 6" />
      <circle cx="104" cy="276" r="4" stroke-dasharray="2 2" />
      <People kind="standing" x={560} y={160} scale={0.7} />
      <path d="M500 190 C 520 180, 530 184, 540 196" stroke-dasharray="2 4" />
    </>}
    {art === 'evening' && <>
      <path d="M60 180 C 180 174, 300 186, 420 178 C 520 172, 580 182, 620 178" />
      <path d="M90 180 V166 M300 180 V166 M430 180 V166 M520 180 V166 M600 180 V166" />
      <path class="band" d="M130 190 H280" stroke-width="6" stroke-opacity=".35" />
      <People kind="listener" x={170} y={96} scale={0.56} />
      <People kind="speaker" x={232} y={96} scale={0.56} />
      <path class="talk" d="M180 88 C 190 76, 212 76, 222 88" stroke-dasharray="2 5" />
      <path d="M440 120 H490 V150 H440 Z M448 130 H482 M448 140 H474" stroke-width="1.3" />
      <path d="M506 112 H548 V152 H506 Z M514 124 H540 M514 134 H540 M514 144 H530" stroke-width="1.3" />
      <path d="M568 118 H606 V148 H568 Z" stroke-width="1.3" />
      <circle cx="616" cy="92" r="14" /><path d="M610 92 A 8 8 0 1 0 622 86" stroke-width="1.3" />
    </>}
    {art === 'voice' && <>
      <rect x="140" y="80" width="40" height="88" rx="20" />
      <path d="M124 150 C 124 184, 196 184, 196 150 M160 184 V212 M136 212 H184" />
      <path d="M220 110 C 240 100, 250 120, 270 110 C 290 100, 300 120, 320 110" stroke-width="1.4" />
      <path d="M220 134 C 240 124, 250 144, 270 134 C 290 124, 300 144, 320 134" stroke-width="1.4" />
      <path d="M220 158 C 240 148, 250 168, 270 158" stroke-width="1.4" />
      <path d="M340 134 H380" stroke-dasharray="3 5" /><path d="M372 126 L382 134 L372 142" />
      <path d="M400 70 H600 V260 H400 Z" />
      <path d="M420 100 H560 M420 122 H580 M420 144 H540 M420 166 H580 M420 188 H500 M420 220 H580 M420 242 H520" stroke-width="1.3" />
    </>}
  </g>
  {art === 'phone' && <><text class="lab" x="300" y="208">22:40</text><path class="marker" d="M292 196 C 310 184, 356 186, 358 206 C 360 226, 312 232, 296 220 C 286 212, 288 202, 296 196" /></>}
  {art === 'door' && <><text class="lab" x="470" y="196">AI · rămâne afară</text><text class="lab" x="372" y="196">pragul</text></>}
  {art === 'search' && <><text class="lab" x="100" y="300">al cincilea nu apare</text><path class="marker" d="M94 286 C 160 282, 300 286, 440 284" stroke-width="7" /></>}
  {art === 'evening' && <><text class="lab" x="130" y="214">timpul cu oamenii</text><text class="lab" x="440" y="214">a doua tură</text><path class="marker" d="M432 206 C 480 200, 560 204, 616 202" stroke-width="7" /></>}
  {art === 'voice' && <><text class="lab" x="124" y="238">3 minute</text><text class="lab" x="400" y="286">în vocea ta</text><path class="marker" d="M396 274 C 440 270, 520 274, 560 272" stroke-width="7" /></>}
</svg>
<style>
  .jart { width: 100%; height: auto; color: var(--ink); display: block; border-radius: var(--r); }
  .jart .lab { font-family: var(--mono); font-size: 13px; letter-spacing: .06em; text-transform: uppercase; fill: var(--muted); }
  .jart .marker { fill: none; stroke: var(--signal); stroke-width: 6; stroke-linecap: round; opacity: .95; }
  .jart .leafp { fill: var(--signal) !important; stroke: currentColor !important; stroke-width: 1.5 !important; }
  .jart .talk { stroke: var(--plum) !important; }
</style>
