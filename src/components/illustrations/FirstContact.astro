---
// Desenul 3: primul contact. Un om scrie la 22:40; răspunsul la logistică pleacă fără tine; omul își alege ora; tu primești notificarea și decizi dimineața.
import HandFilter from './HandFilter.astro';
import People from './People.astro';
interface Props { class?: string; id?: string }
const { class: cls = '', id = 'fc' } = Astro.props;
---
<svg class={`firstcontact ${cls}`} viewBox="0 0 680 360" role="img" aria-labelledby={`${id}-t`}>
  <title id={`${id}-t`}>Primul contact: un om scrie la 22:40, primește imediat prețul, programul și pașii, își alege singur un interval din calendarul tău, tu primești notificarea și decizi dimineața. Niciun AI nu citește mesajul.</title>
  <HandFilter id={`${id}-hand`} />
  <g filter={`url(#${id}-hand)`} class="hand-ink draw">
    <People kind="phone" x={70} y={118} scale={0.8} />
    <path d="M118 130 C 150 110, 190 110, 214 130" stroke-dasharray="3 5" />
    <path d="M214 96 H404 V190 H214 Z" />
    <path d="M232 118 H386 M232 136 H370 M232 154 H386 M232 172 H330" stroke-width="1.4" />
    <path d="M404 143 C 430 143, 436 120, 460 120" stroke-dasharray="3 5" />
    <path d="M460 92 H640 V150 H460 Z" />
    <path d="M478 112 H540 M478 132 H560" stroke-width="1.4" />
    <path d="M580 104 H626 V140 H580 Z M588 116 H618 M588 128 H612" stroke-width="1.3" />
    <path d="M404 160 C 440 160, 440 250, 470 250" stroke-dasharray="3 5" />
    <People kind="listener" x={514} y={222} scale={0.72} />
    <path d="M548 236 H612 V276 H548 Z M556 250 H604 M556 262 H596" stroke-width="1.3" />
    <path d="M300 190 V228" stroke-dasharray="3 5" />
    <path d="M214 228 H404 V298 H214 Z" />
    <path d="M232 250 H386 M232 268 H340" stroke-width="1.4" />
    <path d="M60 246 H190 V298 H60 Z" stroke-dasharray="4 4" />
  </g>
  <text class="lab" x="40" y="60">22:40 · omul scrie</text>
  <text class="lab" x="214" y="84">în 10 secunde · răspunsul la logistică</text>
  <text class="small" x="232" y="124">preț · program · cum arată prima întâlnire</text>
  <text class="small" x="232" y="160">„Dacă ești în pericol, sună acum la 112.”</text>
  <text class="lab" x="460" y="80">omul își alege ora</text>
  <text class="small" x="478" y="118">din calendarul tău</text>
  <text class="small" x="478" y="138">cu regulile tale de anulare</text>
  <text class="lab" x="470" y="212">07:40 · tu decizi</text>
  <text class="small" x="470" y="300">notificarea te așteaptă; confirmi sau nu</text>
  <text class="lab" x="214" y="222">ce nu se întâmplă</text>
  <text class="small" x="232" y="256">niciun AI nu citește mesajul omului</text>
  <text class="small" x="232" y="274">nimic nu pleacă în numele tău nescris de tine</text>
  <text class="small dim" x="70" y="268">tu dormi</text>
  <text class="small dim" x="70" y="286">telefonul e sub masă</text>
  <path class="marker" d="M56 240 C 90 232, 170 232, 196 244" fill="none" stroke="#D6FF55" stroke-width="6" stroke-linecap="round" opacity=".95" />
</svg>
<style>
  .firstcontact { width: 100%; height: auto; color: var(--ink); }
  .firstcontact .lab { font-family: var(--mono); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; fill: var(--plum); }
  .firstcontact .small { font-family: var(--text); font-size: 13px; fill: var(--ink); }
  .firstcontact .small.dim { fill: var(--muted); font-style: italic; }
  .on-dark .firstcontact { color: var(--paper); }
  .on-dark .firstcontact .lab { fill: var(--signal); }
  .on-dark .firstcontact .small { fill: var(--paper); }
  .on-dark .firstcontact .small.dim { fill: var(--muted-light); }
</style>
