---
// Desenul 2: harta. În cameră, doi oameni; între cameră și sistem, ușa; dincolo, ce construim împreună.
import HandFilter from './HandFilter.astro';
import People from './People.astro';
interface Props { class?: string; id?: string }
const { class: cls = '', id = 'map' } = Astro.props;
---
<svg class={`maproom ${cls}`} viewBox="0 0 680 400" role="img" aria-labelledby={`${id}-t`}>
  <title id={`${id}-t`}>Harta: în cameră, doi oameni stau de vorbă și relația rămâne la tine; între cameră și sistem e ușa Room for People; dincolo de ea construim drumul până la tine, primul contact, administrarea și vocea</title>
  <HandFilter id={`${id}-hand`} />
  <text class="lab" x="20" y="34">Camera · ce rămâne la tine</text>
  <text class="lab" x="300" y="34" text-anchor="middle">Pragul</text>
  <text class="lab" x="410" y="34">Sistemul · ce construim împreună</text>
  <g filter={`url(#${id}-hand)`} class="hand-ink draw">
    <People kind="listener" x={78} y={150} scale={1} />
    <People kind="speaker" x={206} y={150} scale={1} />
    <path class="floor" d="M40 254 H244" />
    <path class="talk" d="M100 146 C 120 128, 164 128, 184 146" stroke-dasharray="2 5" />
    <g class="doorway" transform="translate(272,120)">
      <rect x="0" y="0" width="56" height="70" rx="3" stroke-width="2.6" />
      <path class="leafp" d="M8 3 L27 10 L27 60 L8 67 Z" />
    </g>
    <path class="route" d="M244 196 C 258 196, 262 160, 272 156" stroke-dasharray="3 5" />
    <path class="route" d="M328 156 C 350 156, 356 110, 392 110" stroke-dasharray="3 5" />
    <path class="route" d="M328 156 C 350 156, 356 186, 392 186" stroke-dasharray="3 5" />
    <path class="route" d="M328 156 C 350 156, 356 262, 392 262" stroke-dasharray="3 5" />
    <path class="route" d="M328 156 C 350 156, 356 338, 392 338" stroke-dasharray="3 5" />
    <path class="box" d="M392 84 H660 V138 H392 Z" />
    <path class="box" d="M392 160 H660 V214 H392 Z" />
    <path class="box" d="M392 236 H660 V290 H392 Z" />
    <path class="box" d="M392 312 H660 V366 H392 Z" />
  </g>
  <rect x="44" y="286" width="90" height="14" fill="#D6FF55" transform="rotate(-1.4 89 293)" />
  <text class="big" x="48" y="298">Relația</text>
  <text class="small" x="48" y="324">evaluarea · decizia · tăcerea potrivită</text>
  <text class="small" x="48" y="342">datele oamenilor</text>
  <text class="small dim" x="48" y="372">Aici nu intră niciun instrument.</text>
  <text class="prag" x="300" y="214" text-anchor="middle">Room for People</text>
  <g class="node"><circle cx="410" cy="108" r="4" /><text x="424" y="113">Drumul până la tine</text><text class="ex" x="424" y="131">site · Google · răspunsurile AI</text></g>
  <g class="node"><circle cx="410" cy="184" r="4" /><text x="424" y="189">Primul contact</text><text class="ex" x="424" y="207">primele 10 minute după mesaj</text></g>
  <g class="node"><circle cx="410" cy="260" r="4" /><text x="424" y="265">Administrarea</text><text class="ex" x="424" y="283">programări · facturi · materiale</text></g>
  <g class="node"><circle cx="410" cy="336" r="4" /><text x="424" y="341">Vocea ta în lume</text><text class="ex" x="424" y="359">articole · postări · newsletter</text></g>
  <text class="small dim" x="392" y="390">Tu aprobi. Sistemul duce.</text>
</svg>
<style>
  .maproom { width: 100%; height: auto; max-width: 680px; color: var(--paper); }
  .maproom .hand-ink path, .maproom .hand-ink circle, .maproom .hand-ink rect { stroke: currentColor; }
  .maproom .floor { stroke: var(--muted-light) !important; stroke-width: 1.2 !important; }
  .maproom .talk { stroke: var(--signal) !important; stroke-width: 1.6 !important; }
  .maproom .doorway .leafp { fill: var(--signal) !important; stroke: var(--plum) !important; stroke-width: 1.5 !important; }
  .maproom .route { stroke: var(--muted-light) !important; stroke-width: 1.2 !important; }
  .maproom .box { fill: rgba(242, 238, 232, .05) !important; stroke: var(--muted-light) !important; stroke-width: 1.4 !important; }
  .maproom .lab { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; fill: var(--muted-light); }
  .maproom .prag { fill: var(--signal); font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; }
  .maproom .big { font-family: var(--display); font-weight: 800; font-size: 30px; fill: var(--paper); letter-spacing: -0.02em; paint-order: stroke; stroke: var(--plum); stroke-width: 1.5px; stroke-linejoin: round; }
  .maproom .small { font-family: var(--text); font-size: 13px; fill: var(--paper); }
  .maproom .small.dim { fill: var(--muted-light); font-style: italic; }
  .maproom .node circle { fill: var(--signal); stroke: none; }
  .maproom .node text { font-family: var(--display); font-weight: 700; font-size: 15px; fill: var(--paper); }
  .maproom .node .ex { font-family: var(--text); font-size: 12px; font-weight: 400; fill: var(--muted-light); }
  .on-paper .maproom { color: var(--ink); }
  .on-paper .maproom .big, .on-paper .maproom .small, .on-paper .maproom .node text { fill: var(--ink); }
  .on-paper .maproom .big { stroke: var(--paper); }
  .on-paper .maproom .small.dim, .on-paper .maproom .node .ex, .on-paper .maproom .lab { fill: var(--muted); }
  .on-paper .maproom .floor, .on-paper .maproom .route, .on-paper .maproom .box { stroke: var(--muted) !important; }
  .on-paper .maproom .box { fill: rgba(20, 18, 22, .03) !important; }
  .on-paper .maproom .doorway .leafp { stroke: var(--ink) !important; }
</style>
