---
// Alfabetul de personaje: aceleași siluete, desenate de aceeași mână, peste tot.
// Fiecare e un <g> cu coordonate locale; se așază cu transform.
interface Props { kind: 'listener' | 'speaker' | 'standing' | 'phone' | 'child' | 'parent'; x?: number; y?: number; scale?: number }
const { kind, x = 0, y = 0, scale = 1 } = Astro.props;
---
<g class="person" transform={`translate(${x} ${y}) scale(${scale})`}>
  {kind === 'listener' && <>
    <circle cx="0" cy="0" r="13" />
    <path d="M0 13 C -8 30, -10 50, -8 72" />
    <path d="M-8 72 H26 V102" />
    <path d="M-2 32 C 10 40, 18 46, 24 56" />
    <path d="M-16 72 V104 M-16 82 H-8" />
  </>}
  {kind === 'speaker' && <>
    <circle cx="0" cy="0" r="13" />
    <path d="M0 13 C 8 30, 10 50, 8 72" />
    <path d="M8 72 H-26 V102" />
    <path d="M2 32 C -10 40, -18 46, -24 56" />
    <path d="M16 72 V104 M16 82 H8" />
  </>}
  {kind === 'standing' && <>
    <circle cx="0" cy="0" r="12" />
    <path d="M0 12 V62" />
    <path d="M0 26 C -12 36, -16 46, -18 58" />
    <path d="M0 26 C 12 36, 16 46, 18 58" />
    <path d="M0 62 C -8 78, -10 92, -12 108" />
    <path d="M0 62 C 8 78, 10 92, 12 108" />
  </>}
  {kind === 'phone' && <>
    <circle cx="0" cy="0" r="12" />
    <path d="M0 12 V60" />
    <path d="M0 26 C -10 34, -14 42, -14 52 L -4 48" />
    <path d="M0 26 C 12 32, 16 36, 14 44" />
    <rect x="8" y="40" width="10" height="16" rx="2" />
    <path d="M0 60 C -8 76, -10 92, -12 106" />
    <path d="M0 60 C 8 76, 10 92, 12 106" />
  </>}
  {kind === 'child' && <>
    <circle cx="0" cy="0" r="9" />
    <path d="M0 9 V42" />
    <path d="M0 18 C -8 26, -10 32, -12 40" />
    <path d="M0 18 C 8 26, 10 32, 12 40" />
    <path d="M0 42 C -5 54, -6 64, -7 74" />
    <path d="M0 42 C 5 54, 6 64, 7 74" />
  </>}
  {kind === 'parent' && <>
    <circle cx="0" cy="0" r="12" />
    <path d="M0 12 V62" />
    <path d="M0 26 C -12 36, -16 46, -18 58" />
    <path d="M0 26 C 12 34, 20 42, 30 46" />
    <path d="M0 62 C -8 78, -10 92, -12 108" />
    <path d="M0 62 C 8 78, 10 92, 12 108" />
    <circle cx="38" cy="50" r="9" />
    <path d="M38 59 V90" />
    <path d="M38 68 C 32 74, 30 80, 29 88" />
    <path d="M38 90 C 34 100, 33 106, 32 112 M38 90 C 42 100, 43 106, 44 112" />
  </>}
</g>
