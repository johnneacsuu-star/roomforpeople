---
// Formularul real. Trimite JSON la /api/contact; afișează succes doar la răspuns 200.
import { SITE, PROFESII } from '../config';
import { link } from '../lib/links';
interface Props {
  tip?: 'contact' | 'primul-pas' | 'radiografia' | 'harta' | 'oglinda' | 'prezenta' | 'sistem' | 'voce';
  path?: string;
  showRadiografia?: boolean;
  showNewsletter?: boolean;
  showMessage?: boolean;
  showName?: boolean;
  submitLabel?: string;
  intro?: string;
  compact?: boolean;
  id?: string;
}
const {
  tip = 'contact', path = '/', showRadiografia = false, showNewsletter = false, showMessage = true, showName = true,
  submitLabel = 'Trimite', intro, compact = false, id = 'f-' + tip,
} = Astro.props;
---
<form class={`cform ${compact ? 'cform-compact' : ''}`} id={id} data-tip={tip} data-api="/api/contact" novalidate>
  {intro && <p class="small muted">{intro}</p>}
  <div class="cform-grid">
    {showName && <div class="field"><label for={`${id}-nume`}>Numele tău <span class="muted" style="font-weight:400">(opțional)</span></label><input id={`${id}-nume`} name="nume" type="text" autocomplete="name" maxlength="120" /></div>}
    <div class="field"><label for={`${id}-email`}>Email</label><input id={`${id}-email`} name="email" type="email" autocomplete="email" required inputmode="email" placeholder="numele@cabinet.ro" maxlength="200" /></div>
    <div class="field"><label for={`${id}-profesie`}>Lucrez ca</label>
      <select id={`${id}-profesie`} name="profesie">
        {PROFESII.map((p) => <option value={p.id}>{p.label}</option>)}
        <option value="alta">Altă profesie care lucrează cu oameni</option>
      </select>
    </div>
  </div>
  {showMessage && <div class="field"><label for={`${id}-mesaj`}>Ce te-ar ajuta? <span class="muted" style="font-weight:400">(opțional)</span></label><textarea id={`${id}-mesaj`} name="mesaj" maxlength="4000" rows="4"></textarea><span class="hint">Fără nume sau detalii despre clienții tăi. Vorbim despre cabinet, nu despre ei.</span></div>}
  {showRadiografia && <label class="check"><input type="checkbox" name="radiografia" /><span>Vreau să discutăm și despre <strong>Radiografia</strong> (serviciu plătit, {SITE.prices.radiografia} lei). Bifarea nu e o comandă și nu te obligă la nimic; stabilim împreună dacă are sens.</span></label>}
  {showNewsletter && <label class="check"><input type="checkbox" name="newsletter" /><span>Vreau și emailul la două săptămâni: un articol, o idee, un lucru de făcut. Te poți dezabona cu un reply.</span></label>}
  <label class="hp" aria-hidden="true">Lasă câmpul gol <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
  <input type="hidden" name="t" value="" />
  <div class="cform-foot">
    <button class="btn btn-signal" type="submit">{submitLabel}</button>
    <p class="note muted">Emailul și profesia ajung la {SITE.founder}, pe email, și nicăieri altundeva. Nu intră în nicio listă fără bifa de mai sus. <a href={link('/confidentialitate', path)}>Cum le folosim.</a></p>
  </div>
  <p class="form-msg" role="status" aria-live="polite" hidden></p>
</form>
<style>
  .cform { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .cform-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .cform-grid .field:first-child:nth-last-child(3) { grid-column: 1 / -1; }
  .cform-foot { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
  .cform-foot .btn { min-width: 220px; }
  .cform-foot .note { flex: 1 1 260px; }
  .cform-foot .note a { text-decoration: underline; }
  @media (max-width: 640px) { .cform-grid { grid-template-columns: 1fr; } .cform-foot .btn { width: 100%; } }
</style>
<script define:vars={{ email: SITE.email, responseTime: SITE.responseTime }}>
  document.querySelectorAll('form.cform').forEach((form) => {
    const msg = form.querySelector('.form-msg');
    const tInput = form.querySelector('input[name="t"]');
    tInput.value = String(Date.now());
    const btn = form.querySelector('button[type="submit"]');
    const show = (kind, html) => { msg.hidden = false; msg.dataset.kind = kind; msg.innerHTML = html; msg.scrollIntoView({ block: 'nearest', behavior: 'smooth' }); };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { show('error', 'Am nevoie de un email valid ca să îți pot răspunde.'); form.querySelector('input[name="email"]').focus(); return; }
      const payload = {
        tip: form.dataset.tip, nume: fd.get('nume') || '', email, profesie: fd.get('profesie') || '',
        mesaj: fd.get('mesaj') || '', radiografia: fd.get('radiografia') === 'on', newsletter: fd.get('newsletter') === 'on',
        website: fd.get('website') || '', t: Number(tInput.value),
      };
      if (form.dataset.harta) { try { payload.harta = JSON.parse(form.dataset.harta); } catch {} }
      btn.disabled = true; const old = btn.textContent; btn.textContent = 'Se trimite…';
      try {
        const r = await fetch(form.dataset.api, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        let data = {}; try { data = await r.json(); } catch {}
        if (r.ok && data.ok) {
          show('ok', `Mulțumesc. Mesajul a ajuns la Ionuț. Îți răspunde personal, ${responseTime}, de pe adresa lui, nu de la un sistem.`);
          form.querySelectorAll('input:not([type=hidden]):not([name=website]), textarea').forEach((i) => { if (i.type === 'checkbox') i.checked = false; else i.value = ''; });
        } else if (r.status === 503) {
          show('error', `Formularul nu e încă legat la email. Scrie-mi direct la <a href="mailto:${emailSite()}">${emailSite()}</a> și îți răspund eu.`);
        } else if (r.status === 400 && data.error === 'timing') {
          show('error', 'Formularul s-a trimis prea repede ca să fie sigur că nu e un robot. Mai încearcă o dată.');
          tInput.value = String(Date.now() - 5000);
        } else {
          show('error', `Nu a plecat. Încearcă din nou sau scrie-mi direct la <a href="mailto:${emailSite()}">${emailSite()}</a>.`);
        }
      } catch {
        show('error', `Nu a plecat: conexiunea a picat. Încearcă din nou sau scrie-mi direct la <a href="mailto:${emailSite()}">${emailSite()}</a>.`);
      } finally { btn.disabled = false; btn.textContent = old; }
    });
    function emailSite() { return email; }
  });
</script>
