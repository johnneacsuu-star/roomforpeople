---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Harta from '../components/Harta.astro';
const path = '/harta';
---
<Base title="Harta cabinetului · gratuită, 4 minute" description="Opt întrebări, patru direcții, rezultatul pe loc. Afli unde pierzi timp și oameni în jurul cabinetului și care e primul pas pe fiecare direcție. Fără email, fără date despre clienți." path={path} bodyClass="harta-page">
  <PageHead label="Harta cabinetului · gratuit · fără email" lede="Opt întrebări, două pe ecran, despre cum arată drumul unui om până la tine și restul zilei tale. Rezultatul se vede pe loc, cu un prim pas pe fiecare direcție. Îl poți descărca. Nu îți cerem emailul pentru el.">
    <Fragment slot="title">Patru direcții. <span class="mk">O hartă</span> a cabinetului tău.</Fragment>
  </PageHead>
  <section class="section-tight harta-host">
    <div class="wrap"><Harta path={path} standalone /></div>
  </section>
</Base>
