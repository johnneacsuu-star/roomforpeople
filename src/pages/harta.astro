---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Harta from '../components/Harta.astro';
import Art from '../components/Art.astro';
const path = '/harta';
---
<Base title="Harta cabinetului · gratuită, 4 minute" description="Opt întrebări, patru locuri din cabinet, rezultatul pe loc. Afli unde se oprește omul care te caută și care e primul pas pe fiecare loc. Fără email, fără date despre clienți." path={path} bodyClass="harta-page">
  <PageHead label="Harta cabinetului · gratuit · fără email" lede="Opt întrebări, două pe ecran, despre cum arată drumul unui om până la tine și restul zilei tale. Rezultatul se vede pe loc, cu un prim pas pe fiecare loc din cabinet. Îl poți descărca. Emailul rămâne al tău.">
    <Fragment slot="title">Patru locuri. <span class="mk">O hartă</span> a cabinetului tău.</Fragment>
  </PageHead>
  <section class="section-tight harta-host">
    <div class="wrap harta-grid">
      <aside class="harta-side no-print"><Art name="harta" /><p class="note muted">Harta cabinetului, desenată ca un plan de casă: afară, prezența; la ușă, primul contact; înăuntru, programările; pe raft, vocea. Camera rămâne doar a oamenilor.</p></aside>
      <div><Harta path={path} standalone /></div>
    </div>
  </section>
  <style>
    .harta-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
    .harta-side { position: sticky; top: 92px; display: flex; flex-direction: column; gap: 12px; }
    @media (max-width: 900px) { .harta-grid { grid-template-columns: 1fr; } .harta-side { position: static; max-width: 360px; } }
  </style>
</Base>
