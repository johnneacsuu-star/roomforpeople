---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import Portrait from '../components/Portrait.astro';
import Harta from '../components/Harta.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, PROFESII } from '../config';
import { ZIUA } from '../lib/ziua';
import { DRUMURI } from '../lib/drumuri';
import { link, asset } from '../lib/links';
import PostImage from '../components/PostImage.astro';
import { publishedPosts, fmtDate } from '../lib/jurnal';

const path = '/';
const L = (p: string) => link(p, path);
const posts = await publishedPosts();
const showJournal = posts.length >= SITE.journalMinPublished;
const lei = (n: number) => n.toLocaleString('ro-RO');
const description = 'Site, primul contact, programări și materiale puse la lucru în cabinetul tău, ca seara să fie a ta. Pentru psihologi, psihoterapeuți, asistenți sociali și coachi. Construite de un asistent social cu 23 de ani lângă oameni.';
---
<Base title="Room for People" description={description} path={path}>

  <!-- 01 HERO -->
  <section class="hero section-tight" aria-labelledby="h-hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="label muted">Pentru psihologi, psihoterapeuți, asistenți sociali și coachi</p>
        <h1 id="h-hero">Lucrezi cu oameni. <span class="mk">Restul</span> ar trebui să meargă singur.</h1>
        <p class="lede">Site, primul contact, programări și materiale, puse la lucru în cabinetul tău, ca seara să fie a ta. Construite de un asistent social cu 23 de ani lângă oameni, care le-a folosit întâi pe el.</p>
        <div class="hero-cta">
          <a class="btn btn-signal" href={L('/harta')}>Îmi fac Harta cabinetului</a>
          <p class="small muted">Gratuită · 4 minute · rezultatul pe loc, fără email</p>
        </div>
        <ul class="hero-facts small muted">
          <li>Prețuri la vedere</li><li>Nicio dată de client într-un AI</li><li>Răspunde Ionuț, personal</li>
        </ul>
        <p class="small"><a class="textlink" href="#drumuri">Vezi cele trei drumuri și prețurile</a></p>
      </div>
      <figure class="hero-fig"><Art name="plan" /></figure>
    </div>
  </section>

  <!-- 02 CE IEI ACASĂ -->
  <section class="section on-white" aria-labelledby="h-acasa">
    <div class="wrap">
      <div class="sec-head"><span class="wp">02</span><span class="label">Ce iei acasă</span></div>
      <h2 id="h-acasa" class="sr">Trei promisiuni</h2>
      <div class="g-3 promises">
        <div class="promise">
          <h3>Seara e <span class="mk">a ta</span>.</h3>
          <p>Confirmările, reprogramările și facturile pleacă singure, la ora aleasă de tine. Ce rămâne după 18:00 e doar ce vrei tu să rămână.</p>
        </div>
        <div class="promise">
          <h3>Vocea e <span class="mk">a ta</span>.</h3>
          <p>Fiecare mesaj automat, pagină și articol e scris din cuvintele tale și aprobat de tine. Nimic nu pleacă în numele tău fără să-l fi citit.</p>
        </div>
        <div class="promise">
          <h3>Datele rămân <span class="mk">la tine</span>.</h3>
          <p>Nicio informație despre un client nu intră într-un instrument AI. Lucrăm cu materialele tale publice și cu procesele cabinetului. Regula e scrisă și e aceeași pentru noi și pentru tine.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 ZIUA TA -->
  <section class="section" id="ziua" aria-labelledby="h-ziua">
    <div class="wrap">
      <div class="sec-head"><span class="wp">03</span><span class="label">Ziua ta · marți, 22:40</span></div>
      <div class="split" style="align-items:center">
        <div class="stack" style="gap:20px">
          <h2 id="h-ziua">Ziua cu oamenii se termină la 18:00. Seara ar trebui să fie a ta.</h2>
          <p class="muted" style="max-width:56ch">Aceeași zi, două seri. Scenariul de mai jos e scris pentru cabinetul plin și pentru cel care vrea să crească: în ambele, ce pleacă singur e același lucru.</p>
          <div class="pills" role="group" aria-label="Alege profesia">
            {ZIUA.map((s, i) => <button type="button" class="pill" data-scenariu={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.label}</button>)}
          </div>
        </div>
        <div class="phone-wrap">
          <div class="phone" aria-label="Telefonul tău, marți seara">
            <div class="island" aria-hidden="true"></div>
            <div class="screen">
              <div class="lock"><span class="label">Marți</span><span class="phone-clock">22:40</span></div>
              {ZIUA.map((s, i) => (
                <div class="phone-msgs" data-scenariu={s.id} hidden={i !== 0}>
                  {s.phone.map((m, j) => <div class="msg"><span class="msg-head"><span class="app">{j % 2 ? 'WhatsApp' : 'Mesaje'}</span><span>{m[0]}</span></span><p>{m[1]}</p></div>)}
                </div>
              ))}
              <p class="note phone-foot">Niciunul nu e urgent. Toate așteaptă un răspuns. De la tine.</p>
              <div class="homebar" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </div>
      {ZIUA.map((s, i) => (
        <div class="day" data-scenariu={s.id} hidden={i !== 0}>
          <p class="day-lead"><span class="hl">{s.lead}</span></p>
          <div class="day-head" aria-hidden="true"><span class="label muted">Marți, azi</span><span></span><span class="label muted">Marți, cu sistem</span></div>
          <ol class="day-list">
            {s.momente.map((m) => (
              <li class={m.ora === '22:40' ? 'key' : ''}>
                <div class="d-azi"><strong>{m.azi}</strong><span class="small muted">{m.aziNota}</span></div>
                <div class="d-ora"><span>{m.ora}</span></div>
                <div class="d-sis"><strong>{m.sistem}</strong><span class="small">{m.sistemNota}</span></div>
              </li>
            ))}
          </ol>
          <p class="note muted day-band">Între 09:00 și 18:00, timpul cu oamenii. Neatins. Aici nu intră niciun instrument.</p>
        </div>
      ))}
    </div>
  </section>

  <!-- 04 TREI DRUMURI -->
  <section class="section on-white" id="drumuri" aria-labelledby="h-drumuri">
    <div class="wrap">
      <div class="sec-head"><span class="wp">04</span><span class="label">Trei drumuri · preț de pornire la vedere</span></div>
      <div class="split" style="align-items:end;margin-bottom:36px">
        <h2 id="h-drumuri">Trei drumuri. Alegi unul, nu toate.</h2>
        <p class="muted">Fiecare drum are livrabile scrise, un preț de pornire și o ușă pe care o deschizi singur. Prețurile sunt de lansare, pentru primele 10 cabinete, și se pot schimba după.</p>
      </div>
      <div class="g-3 drumuri">
        {DRUMURI.map((d, i) => (
          <article class="drum door">
            <div class="door-art"><Art name={`usa-${i + 1}`} /></div>
            <span class="label muted">Drumul {d.nr}</span>
            <h3><a href={L(d.path)}>{d.name}</a></h3>
            <p class="small muted">{d.pentru}</p>
            <p class="small"><strong>Problema.</strong> {d.problema}</p>
            <p class="label muted" style="margin-top:6px">Ce primești, concret</p>
            <ul class="ticks small">{d.livrabile.map((l) => <li>{l}</li>)}</ul>
            <p class="small"><strong>Rezultatul.</strong> {d.rezultat}</p>
            <p class="drum-price"><span class="small muted">de la</span> {lei(d.price)} lei</p>
            <a class="textlink" href={L(d.path)}>Vezi drumul {d.name} →</a>
          </article>
        ))}
      </div>
      <p class="note muted" style="margin-top:20px">Înainte de orice drum, <a class="textlink" href={L('/radiografia')}>Radiografia</a>: o săptămână de observație pe cabinetul tău, {lei(SITE.prices.radiografia)} lei, care îți spune care drum e primul.</p>
    </div>
  </section>

  <!-- 05 CINE CONSTRUIEȘTE -->
  <section class="section on-paper" id="cine" aria-labelledby="h-cine">
    <div class="wrap">
      <div class="sec-head"><span class="wp">05</span><span class="label">Cine construiește</span></div>
      <div class="split" style="align-items:end;margin-bottom:40px">
        <h2 id="h-cine">O echipă mică, dar <span class="mk">dedicată</span> cu totul.</h2>
        <p class="muted">Doi oameni. Unul vine din aceeași lume ca tine și a stat 23 de ani în aceeași cameră. Celălalt construiește sistemul din spate și se asigură că merge singur.</p>
      </div>
      <div class="team-grid">
        <div class="member">
          <Portrait src={asset('/img/ionut.webp', path)} alt="Ionuț Neacșu, în sacou bleumarin și cămașă albă, privind spre cameră" name="Ionuț Neacșu" role="Oamenii, meseria și regulile" />
          <div class="stack" style="gap:16px">
            <p>Ionuț Neacșu lucrează de 23 de ani în asistență socială: pe stradă și într-un adăpost, la DGASPC Argeș, la conducerea Asociației „Sprijin pentru Viață” din Pitești, apoi, din 2015, în protecția copilului, în Anglia. E absolvent de psihologie în Marea Britanie, 2025, și folosește zilnic AI din 2022, întâi pe propria lui muncă. Ține partea de oameni: discuția, harta, textele, Regula casei. Și el îți răspunde.</p>
            <dl class="facts">
              <div><dt>2014</dt><dd>Premiul pentru asistentul social din domeniul persoanelor fără adăpost, la Gala Națională a Excelenței în Asistență Socială (CNASR). <a href="https://epitesti.ro/stiri/social/jos-palaria-cel-mai-bun-asistent-social-din-tara-este-un-pitestean" target="_blank" rel="noopener">ePitești</a></dd></div>
              <div><dt>2013</dt><dd>Centrul de zi „PLATO School” din Călinești, primul de acest fel pentru copiii romi din județul Argeș. <a href="https://adevarul.ro/stiri-locale/pitesti/la-calinesti-se-va-infiinta-primul-centru-de-1458978.html" target="_blank" rel="noopener">Adevărul</a></dd></div>
              <div><dt>2026</dt><dd>Finalist la National Children &amp; Young People Awards, categoria Children and Families Social Worker, Marea Britanie.</dd></div>
            </dl>
          </div>
        </div>
        <div class="member">
          <Portrait src={asset('/img/andrei.webp', path)} alt="Andrei N., cu ochelari și sacou negru, cu mâna sub bărbie, privind în lateral" name="Andrei N." role="Partea tehnică și AI" />
          <div class="stack" style="gap:16px">
            <p>Andrei N. ține partea tehnică a AI-ului: sistemele, automatizările și legăturile dintre ele, de la formularul de pe site la confirmarea din calendar. E creatorul și omul din spatele <a class="textlink" href="https://blackstonerepair.co.uk" target="_blank" rel="noopener">Blackstone Repair</a>, un atelier din Marea Britanie care repară plăci video la nivel de componentă, cu programare și urmărire online a fiecărei reparații.</p>
            <p class="small muted">Lucrează după aceeași regulă a casei: nicio dată despre clienții tăi în instrumente. Nu există departament de vânzări și nu există robot care răspunde în locul lor.</p>
          </div>
        </div>
      </div>
      <p class="small" style="margin-top:28px"><a class="textlink" href={L('/cine')}>Tot parcursul, valorile și limitele asumate →</a></p>
    </div>
  </section>

  <!-- 06 REGULA CASEI -->
  <section class="section on-dark" id="regula" aria-labelledby="h-regula">
    <div class="wrap">
      <div class="sec-head"><span class="wp">06</span><span class="label">Regula casei</span></div>
      <div class="split" style="align-items:start">
        <div class="stack" style="gap:20px">
          <h2 id="h-regula">Nicio informație despre un client nu intră într-un instrument AI. <span class="mk mk-dark">Niciodată.</span></h2>
          <p class="lede muted">Nu e o promisiune de marketing. E o limită pe care o respectăm noi și pe care o cerem și de la tine. Lucrăm cu materialele tale publice și cu procesele cabinetului: ce scrie pe site, cum răspunzi la primul mesaj, cum se confirmă o programare. Niciodată cu ce se spune în cameră.</p>
          <div class="card">
            <p class="label" style="color:var(--signal)">Profesionistul rămâne autorul</p>
            <p>Nimic nu pleacă în numele tău fără să-l fi citit. Fiecare mesaj automat e scris de tine o singură dată. Fiecare articol trece pe la tine înainte să plece. Sistemul duce; tu decizi.</p>
          </div>
        </div>
        <div class="card semafor">
          <p class="label muted">Protocolul semafor · ce intră unde</p>
          <ul class="stack" style="gap:12px;list-style:none;margin:0;padding:0">
            <li><i style="background:var(--ok)"></i><span><strong>Verde.</strong> Materiale publice, texte proprii, idei de postări. Intră în instrumentele aprobate.</span></li>
            <li><i style="background:var(--warn)"></i><span><strong>Galben.</strong> Organizare fără date identificabile: program, șabloane, întrebări frecvente.</span></li>
            <li><i style="background:var(--alert)"></i><span><strong>Roșu.</strong> Orice dată de caz sau de sănătate. Nu intră în niciun instrument AI. Niciodată.</span></li>
          </ul>
          <p class="note muted">Semaforul e regula noastră de lucru, nu o clasificare juridică. Pentru psihologi, obligațiile vin din Codul deontologic CPR; pentru asistenți sociali, din codul CNASR; pentru coachi, din codul asociației lor. <a href={L('/resurse')}>Ia-l ca afiș pentru perete.</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- 07 HARTA CABINETULUI -->
  <section class="section harta-host" id="harta-sec" aria-labelledby="h-harta">
    <div class="wrap">
      <div class="sec-head no-print"><span class="wp">07</span><span class="label">Harta cabinetului · gratuit · fără email</span></div>
      <div class="harta-intro no-print">
        <figure class="harta-art"><Art name="harta" /></figure>
        <div class="stack" style="gap:18px">
          <h2 id="h-harta">Patru direcții. <span class="mk">O hartă</span> a cabinetului tău.</h2>
          <p class="muted">Opt întrebări, două pe ecran, despre ce se întâmplă în jurul ședințelor. Vezi pe loc unde pierzi timp și oameni, pe patru direcții: prezența, primul contact, programările și vocea.</p>
          <ul class="ticks small"><li>Patru minute, două întrebări pe ecran</li><li>Nicio întrebare despre clienții tăi</li><li>Rezultatul îl vezi imediat; emailul e opțional</li></ul>
          <p><a class="btn btn-ink" href="#harta">Încep harta <span class="small" style="font-family:var(--mono);font-weight:500;margin-left:6px">4 min · 0 lei</span></a></p>
        </div>
      </div>
      <Harta path={path} />
    </div>
  </section>

  <!-- 08 RADIOGRAFIA -->
  <section class="section on-white" id="radiografia" aria-labelledby="h-rad">
    <div class="wrap">
      <div class="sec-head"><span class="wp">08</span><span class="label">Radiografia · după Hartă, înainte de orice drum</span></div>
      <div class="split" style="align-items:start">
        <div class="stack" style="gap:18px">
          <h2 id="h-rad">Ziua ta, radiografiată într-o săptămână.</h2>
          <p class="lede muted">Harta îți arată direcția. Radiografia îți spune, pe cabinetul tău și cu cifre măsurate, unde pierzi timp și oameni, ce poate pleca singur în siguranță și care drum e primul. O citește Ionuț, nu un chestionar.</p>
          <ul class="small facts">
            <li><strong>Zilele 1–5.</strong> Un jurnal ghidat de două minute pe seară: ce faci în jurul ședințelor și cât durează. Fără date despre clienți.</li>
            <li><strong>Ziua 6.</strong> O sesiune online de 90 de minute, cu un câștig rapid pus la lucru pe loc, de obicei răspunsul la primul contact.</li>
            <li><strong>În 3 zile lucrătoare.</strong> Raportul scris: primele trei automatizări, după ore și efort, Filtrul deontologic pe textele tale publice, Protocolul semafor, planul de 30 de zile.</li>
          </ul>
          <a class="btn btn-ink" href={L('/radiografia')}>Vezi cum se desfășoară</a>
        </div>
        <aside class="card card-paper rad-card">
          <p class="label muted">Preț de lansare · primele 10 cabinete</p>
          <p class="rad-price"><span>{lei(SITE.prices.radiografia)}</span> lei</p>
          <p class="small muted">Apoi {lei(SITE.prices.radiografiaDupa)} lei. Se scade integral din primul drum, dacă începem în 30 de zile.</p>
          <p class="small"><strong>Garanția.</strong> Dacă raportul nu conține cel puțin trei recomandări concrete, pe care le poți aplica singur sau cu noi, primești banii înapoi. Condițiile exacte, în contract.</p>
          <a class="btn btn-signal" href={L('/contact') + '?tip=radiografia'}>Cer Radiografia</a>
          <p class="note muted">Începi oricum cu Harta, gratuit. Radiografia o ceri doar dacă harta îți spune ceva.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- 09 DIN JURNAL (apare doar de la trei articole publicate) -->
  {showJournal && (
    <section class="section" id="jurnal" aria-labelledby="h-jurnal">
      <div class="wrap">
        <div class="sec-head"><span class="wp">09</span><span class="label">Din Jurnal</span></div>
        <div class="split" style="align-items:end;margin-bottom:32px">
          <h2 id="h-jurnal">Educație, nu promovare.</h2>
          <p class="muted">Articole scrise pentru cabinetul tău: un detaliu, un exemplu, un pas pe care îl poți face singur. Fără jargon, fără date despre nimeni.</p>
        </div>
        <div class="g-3">
          {posts.slice(0, 3).map((p) => (
            <a class="card post-card" href={L(`/jurnal/${p.id}`)}>
              <div class="post-card-art"><PostImage post={p} path={path} /></div>
              <span class="label muted">{p.data.pillar} · {fmtDate(p.data.date)}</span>
              <h3>{p.data.title}</h3>
              <p class="small muted">{p.data.description}</p>
            </a>
          ))}
        </div>
        <p class="small" style="margin-top:20px"><a class="textlink" href={L('/jurnal')}>Toate articolele</a></p>
      </div>
    </section>
  )}

  <!-- 10 UN OM, NU UN SISTEM -->
  <section class="section-tight on-paper" id="om" aria-labelledby="h-om">
    <div class="wrap om-grid">
      <Portrait class="small" src={asset('/img/ionut.webp', path)} alt="Ionuț Neacșu" />
      <div class="stack" style="gap:14px">
        <div class="sec-head" style="margin-bottom:6px"><span class="wp">10</span><span class="label">Un om, nu un sistem</span></div>
        <h2 id="h-om" style="font-size:clamp(26px,3.4vw,40px)">Răspunde Ionuț, <span class="mk">personal</span>.</h2>
        <p class="muted">Ionuț și Andrei N., o echipă mică și dedicată cu totul. Nu există departament de vânzări, nu există robot care răspunde în locul lor. Îi poți scrie direct lui Ionuț; {SITE.responseTime} primești un răspuns de pe adresa lui. Dacă vrei să vorbiți 30 de minute, spune-i în mesaj și îți propune două intervale.</p>
        <p><a class="textlink" href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a class="textlink" href={SITE.linkedin} target="_blank" rel="me noopener">LinkedIn</a> · <a class="textlink" href={L('/contact')}>Formularul de contact</a></p>
      </div>
    </div>
  </section>

  <!-- 11 PRIMUL PAS -->
  <section class="section on-dark" id="primul-pas" aria-labelledby="h-pas">
    <div class="wrap">
      <div class="sec-head"><span class="wp">11</span><span class="label">Primul pas</span></div>
      <div class="split" style="align-items:start">
        <div class="stack" style="gap:18px">
          <h2 id="h-pas">Cât spațiu ai, de fapt, pentru oameni?</h2>
          <p class="lede muted">Scrie-i lui Ionuț două rânduri despre cabinetul tău. Primești un răspuns personal cu un prim pas pe care îl poți face singur, {SITE.responseTime}. Fără ofertă nesolicitată, fără listă de emailuri.</p>
          <p class="small muted"><strong>Ce se întâmplă după ce apeși „Trimite”.</strong> Mesajul ajunge în căsuța lui de email și nicăieri altundeva. Îți răspunde el. Dacă ai bifat Radiografia, discutați întâi dacă are sens; nimic nu se plătește pe site.</p>
        </div>
        <div class="card card-paper" style="color:var(--ink)">
          <ContactForm tip="primul-pas" path={path} showRadiografia showNewsletter showMessage showName submitLabel="Trimite primul pas" id="f-primul-pas" />
        </div>
      </div>
    </div>
  </section>

</Base>
<style>
  .hero { padding-top: clamp(40px, 6vw, 72px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .hero-text { display: flex; flex-direction: column; gap: 22px; }
  .hero-text h1 { max-width: 12ch; }
  .hero-cta { display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .hero-cta .btn { min-height: 60px; padding: 0 32px; font-size: 18px; }
  .hero-fig { margin: 0; max-width: 520px; justify-self: center; width: 100%; }
  .hero-facts { list-style: none; margin: 0; padding: 14px 0 0; border-top: 1px solid rgba(20, 18, 22, .15); display: flex; gap: 8px 22px; flex-wrap: wrap; }
  .hero-facts li::before { content: "•"; margin-right: 8px; color: var(--plum); }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .hero-text h1 { max-width: none; } }

  .promises .promise { display: flex; flex-direction: column; gap: 12px; padding-top: 18px; border-top: 2px solid var(--ink); }
  .promises h3 { font-size: clamp(24px, 2.6vw, 32px); }

  .pills { display: flex; gap: 8px; flex-wrap: wrap; }
  .phone-wrap { display: flex; justify-content: center; padding: 10px 0; }
  .phone { width: 300px; max-width: 100%; aspect-ratio: 9 / 17.2; background: #0B0A0D; border-radius: 46px; padding: 12px; box-shadow: 0 0 0 2px #2A2630, 0 40px 70px rgba(53, 34, 79, .3), inset 0 0 0 1px rgba(255, 255, 255, .06); transform: rotate(-4deg); position: relative; color: var(--ink); }
  .phone::before { content: ""; position: absolute; left: -3px; top: 120px; width: 3px; height: 34px; background: #2A2630; border-radius: 2px 0 0 2px; box-shadow: 0 52px 0 #2A2630; }
