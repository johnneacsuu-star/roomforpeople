<script>
  // Scenariul pe profesie: trei variante pre-randate; butoanele doar le arată și le ascund.
  const pills = document.querySelectorAll('.pill[data-scenariu]');
  pills.forEach((p) => p.addEventListener('click', () => {
    const id = p.dataset.scenariu;
    pills.forEach((x) => x.setAttribute('aria-pressed', String(x === p)));
    document.querySelectorAll('[data-scenariu]:not(.pill)').forEach((el) => { el.hidden = el.dataset.scenariu !== id; });
  }));
</script>
