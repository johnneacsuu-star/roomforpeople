---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import PostImage from '../../components/PostImage.astro';
import { publishedPosts, fmtDate } from '../../lib/jurnal';
import { link } from '../../lib/links';
import { SITE } from '../../config';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, prev: posts[i + 1] ?? null, next: posts[i - 1] ?? null } }));
}
const { post, prev, next } = Astro.props;
const { Content } = await render(post);
const path = `/jurnal/${post.id}`; const L = (p: string) => link(p, path);
const jsonLd = { '@context': 'https://schema.org', '@type': 'Article', headline: post.data.title, description: post.data.description, datePublished: post.data.date.toISOString(), author: { '@type': 'Person', name: SITE.founder }, publisher: { '@type': 'Organization', name: SITE.name }, inLanguage: 'ro', mainEntityOfPage: new URL(path, SITE.url).toString() };
---
<Base title={post.data.title} description={post.data.description} path={path} jsonLd={jsonLd}>
  <article class="section-tight">
    <div class="wrap stack" style="gap:22px">
      <p class="label muted"><a href={L('/jurnal')} style="text-decoration:none">Jurnal</a> · {post.data.pillar} · {fmtDate(post.data.date)}</p>
      <h1 style="max-width:22ch">{post.data.title}</h1>
      <p class="lede muted" style="max-width:62ch">{post.data.description}</p>
      <p class="small muted">De {SITE.founder}. Exemplele sunt compuse; nicio situație reală de client nu apare aici.</p>
      <div class="post-hero"><PostImage post={post} path={path} eager showCredit /></div>
      <div class="prose" style="margin-top:12px"><Content /></div>
      {post.data.sources.length > 0 && (
        <div class="stack" style="gap:8px;margin-top:24px;max-width:68ch">
          <p class="label muted">Surse</p>
          <ul class="small" style="margin:0;padding-left:18px">{post.data.sources.map((s) => <li><a class="textlink" href={s.url} target="_blank" rel="noopener">{s.title}</a></li>)}</ul>
        </div>
      )}
      <nav class="post-nav" aria-label="Alte articole">
        {prev && <a href={L(`/jurnal/${prev.id}`)}><span class="label muted">Mai vechi</span><span>{prev.data.title}</span></a>}
        {next && <a href={L(`/jurnal/${next.id}`)} style="text-align:right"><span class="label muted">Mai nou</span><span>{next.data.title}</span></a>}
      </nav>
    </div>
  </article>
  <section class="section-tight on-dark">
    <div class="wrap split" style="align-items:center">
      <div class="stack" style="gap:10px"><h2 style="font-size:clamp(24px,3vw,34px)">Vrei să vezi cum stă cabinetul tău?</h2><p class="muted">Harta cabinetului: opt întrebări, patru minute, rezultatul pe loc. Fără email.</p></div>
      <p><a class="btn btn-signal" href={L('/harta')}>Îmi fac Harta cabinetului</a></p>
    </div>
  </section>
</Base>
<style>
  .post-hero { margin: 8px 0 0; max-width: 880px; }
  .post-nav { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 40px; border-top: 1px solid var(--ink); padding-top: 20px; max-width: 68ch; }
  .post-nav a { display: flex; flex-direction: column; gap: 4px; text-decoration: none; font-family: var(--display); font-weight: 700; }
  .post-nav a:hover span:last-child { text-decoration: underline; text-decoration-color: var(--signal); }
</style>
