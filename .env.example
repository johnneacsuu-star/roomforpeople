# Variabile pentru funcția /api/contact (Vercel → Settings → Environment Variables)
# Niciuna nu e în cod. Fără ele, formularul răspunde cinstit „serviciul nu e configurat”.
RESEND_API_KEY=            # cheie Resend cu drept de trimitere
CONTACT_TO=                # adresa la care ajung mesajele (a lui Ionuț)
CONTACT_FROM=Room for People <onboarding@resend.dev>   # până e verificat roomforpeople.ro în Resend
ALLOWED_ORIGIN=https://roomforpeople.ro                # originea acceptată pentru POST
